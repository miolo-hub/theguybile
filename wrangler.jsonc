// Cloudflare Workers static hosting for The Guybile.
// Build first (python3 scripts/build.py && python3 scripts/verse_cards.py), then: npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theguybile",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
